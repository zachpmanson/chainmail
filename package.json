{
  "name": "chainmail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read an email chain as one chronological transcript, with its reply structure made visible.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src test scripts vite.config.ts vitest.config.ts eslint.config.js",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"scripts/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts eslint.config.js package.json tsconfig.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.ts\" \"scripts/**/*.{ts,tsx}\" vite.config.ts vitest.config.ts eslint.config.js package.json tsconfig.json",
    "gen:types": "json2ts -i schema/timeline.schema.json -o src/lib/timeline/spec.d.ts --additionalProperties false",
    "gen:api": "openapi-typescript api/openapi.json -o src/lib/api/api.d.ts",
    "render": "tsx scripts/render.tsx"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.32",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "esbuild": "^0.24.2",
    "eslint": "10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^6.0.7",
    "vitest": "^5.0.3"
  }
}
